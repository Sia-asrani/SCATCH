<%- include('./partials/header') %>
<div class="min-h-screen bg-gray-100 py-8">
    <div class="container mx-auto px-4">
        <h1 class="text-3xl font-bold text-center mb-8">Your Shopping Cart</h1>
        <% if (user.cart.length === 0) { %>
            <p class="text-center text-gray-500">Your cart is empty.</p>
        <% } else { %>
            <div class="space-y-6">
                <% for(let i=0; i<user.cart.length; i++) { let item = user.cart[i]; %>
                    <div class="bg-white rounded-lg shadow-md p-6 flex items-center">
                        <div class="w-24 h-24 bg-gray-200 rounded-md overflow-hidden mr-6">
                            <img class="w-full h-full object-cover" src="data:image/jpeg;base64,<%= item.product.image.toString('base64') %>" alt="<%= item.product.name %>">
                        </div>
                        <div class="flex-1">
                            <h3 class="text-xl font-semibold"><%= item.product.name %></h3>
                            <p class="text-gray-600">Price: ₹<%= item.product.price %></p>
                            <p class="text-green-600">Discount: ₹<%= item.product.discount %></p>
                        </div>
                        <div class="flex items-center mr-6">
                            <a href="/decrease/<%= i %>" class="w-8 h-8 bg-gray-200 flex rounded-full items-center justify-center hover:bg-gray-300">-</a>
                            <span class="px-4"><%= item.quantity %></span>
                            <a href="/increase/<%= i %>" class="w-8 h-8 bg-gray-200 flex rounded-full items-center justify-center hover:bg-gray-300">+</a>
                        </div>
                        <div class="text-right">
                            <p class="text-lg font-semibold">₹<%= ((item.product.price - item.product.discount) * item.quantity).toFixed(2) %></p>
                        </div>
                    </div>
                <% } %>
            </div>
            <div class="mt-8 bg-white rounded-lg shadow-md p-6">
                <h3 class="text-xl font-semibold mb-4">Price Breakdown</h3>
                <div class="space-y-2">
                    <div class="flex justify-between">
                        <span>Subtotal</span>
                        <span>₹<%= subtotal.toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between">
                        <span>Platform Fee</span>
                        <span>₹20</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Shipping Fee</span>
                        <span>FREE</span>
                    </div>
                    <hr class="my-2">
                    <div class="flex justify-between text-xl font-bold">
                        <span>Total Amount</span>
                        <span class="text-green-600">₹<%= bill.toFixed(2) %></span>
                    </div>
                </div>
                <div class="mt-6">
                    <button class="w-full bg-blue-600 text-white py-3 rounded-md hover:bg-blue-700">Proceed to Checkout</button>
                </div>
            </div>
        <% } %>
    </div>
</div>
<%- include('./partials/footer') %>