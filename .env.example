# Environment Variables Configuration
# This is an EXAMPLE file. Copy this file as .env and fill in your actual values.
# IMPORTANT: Never commit .env to Git. Keep sensitive keys confidential.

# JWT Secret Key - Used for signing and verifying JWT tokens
# Generate a strong random string (at least 32 characters)
# Example: Use a tool like: https://www.uuidgenerator.net/ or `openssl rand -base64 32`
JWT_KEY=your_super_secret_jwt_key_here_make_it_long_and_random_at_least_32_chars

# Express Session Secret - Used for encrypting session data
# Generate a strong random string (at least 32 characters)
# This should be different from JWT_KEY
EXPRESS_SESSION_SECRET=your_session_secret_key_make_it_random_and_at_least_32_chars_too

# Optional: MongoDB Connection String (if using external MongoDB)
# Default is mongodb://localhost:27017/scatch (local MongoDB)
# Uncomment and modify if using MongoDB Atlas or other remote instance
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/scatch

# Optional: Port Configuration
# Default port is 3000. Change here if needed.
# PORT=3000

# Optional: Node Environment
# Set to 'development' or 'production'
# NODE_ENV=development
